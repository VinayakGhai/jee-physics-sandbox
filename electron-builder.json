{
  "appId": "com.jeephysics.sandbox",
  "productName": "JEE-Physics-Sandbox",
  "executableName": "jee-physics-sandbox",
  "artifactName": "${executableName}-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "dist_desktop"
  },
  "files": [
    "dist/**/*",
    "desktop-main.cjs",
    "package.json"
  ],
  "icon": "assets/logo.png",
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Education",
    "icon": "assets/logo.png",
    "artifactName": "${executableName}_${version}_${arch}.${ext}"
  },
  "win": {
    "target": ["nsis", "portable", "zip"],
    "icon": "assets/logo.png"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.education",
    "icon": "assets/logo.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
