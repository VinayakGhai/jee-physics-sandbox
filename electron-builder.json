{
  "appId": "com.jeephysics.sandbox",
  "productName": "JEE-Physics-Sandbox",
  "directories": {
    "output": "release-builds"
  },
  "files": [
    "dist/**/*",
    "desktop-main.cjs",
    "package.json"
  ],
  "icon": "assets/icon.png",
  "linux": {
    "target": ["AppImage", "tar.gz"],
    "category": "Education",
    "icon": "assets/icon.png"
  },
  "win": {
    "target": ["portable", "zip"],
    "icon": "assets/icon.ico"
  },
  "portable": {
    "artifactName": "JEE-Physics-Sandbox-${version}-Setup.exe"
  }
}
